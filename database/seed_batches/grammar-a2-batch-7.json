    {
      "title": "Must and have to for obligation and rules",
      "description": "Use must and have to for strong obligations and rules.",
      "objective": "Use must and have to for strong obligations and rules.",
      "content": "Must expresses a strong speaker obligation. Have to expresses an external rule or requirement. Use must or have to with the base verb.",
      "examples": [
        "You must wear a helmet.",
        "I have to show my ID at the entrance."
      ],
      "commonErrors": [
        "She musts wear a helmet. -> She must wear a helmet.",
        "He has to studies. -> He has to study."
      ],
      "guidedPractice": "Underline the source of each obligation, then choose must for a speaker decision or have to for an outside rule.",
      "summary": "Must and have to are followed by the base verb and describe necessary actions.",
      "questions": [
        {
          "type": "MULTIPLE_CHOICE",
          "questionText": "The school rule says students ___ wear an ID badge.",
          "options": [
            {
              "text": "must to",
              "isCorrect": false
            },
            {
              "text": "have to",
              "isCorrect": true
            },
            {
              "text": "has to",
              "isCorrect": false
            },
            {
              "text": "having to",
              "isCorrect": false
            }
          ],
          "correctAnswer": "have to",
          "explanation": "The school rule is an external requirement, so use have to with the base verb.",
          "knowledgePoint": "external obligation",
          "difficulty": "easy"
        },
        {
          "type": "MULTIPLE_CHOICE",
          "questionText": "I decided that I ___ finish this report tonight.",
