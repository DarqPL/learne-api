              "isCorrect": false
            },
            {
              "text": "did",
              "isCorrect": false
            }
          ],
          "correctAnswer": "have",
          "explanation": "I takes have in the present perfect: have finished.",
          "knowledgePoint": "have + past participle",
          "difficulty": "easy"
        },
